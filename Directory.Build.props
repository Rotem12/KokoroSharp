<Project>
    <PropertyGroup>
        <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    </PropertyGroup>

    <PropertyGroup>
        <Version>0.8.4</Version>
        <Authors>Lyrcaxis</Authors>
        <RepositoryUrl>https://github.com/Lyrcaxis/KokoroSharp</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Keep generated verification/build trees out of this project graph. -->
        <DefaultItemExcludes>
            $(DefaultItemExcludes);
            **\.codex-build\**;
            **\artifacts\**;
            **\bin\**;
            **\bin_*\**;
            **\obj\**;
            **\obj_*\**;
            **\tmp\**;
            **\temp\**;
            **\tts-store-capture-build-*\**
        </DefaultItemExcludes>
    </PropertyGroup>
</Project>
